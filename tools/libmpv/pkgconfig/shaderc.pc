# static shaderc of MSYS2 with the SPIRV-Tools and glslang it needs
root=C:/msys64/ucrt64
Name: shaderc
Description: shaderc (static)
Version: 2026.1
Libs: -L${root}/lib -lshaderc_combined -lglslang -lglslang-default-resource-limits -lSPIRV-Tools-opt -lSPIRV-Tools -lstdc++
Cflags: -I${root}/include
